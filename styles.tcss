Screen {
    background: #1c1c1c;
    color: #f5f5f5;
}
Header { background: #242424; color: #f5f5f5; }
Footer { background: #242424; color: #919191; }
TabbedContent { height: 1fr; }
TabPane { padding: 1 2; background: #1c1c1c; }
#chat-layout { height: 1fr; }
#status {
    height: auto; min-height: 3; padding: 1; color: #919191;
    border-bottom: solid #4a4a4a;
}
#history { height: 1fr; padding: 1 0; overflow-y: auto; }
.chat-message {
    height: auto; min-height: 3; padding: 1; margin-bottom: 1;
    border-left: thick #919191; background: #242424; color: #f5f5f5;
}
#empty-state { color: #919191; padding: 1; }
#recognized-text {
    height: auto; min-height: 3; padding: 1; color: #919191;
    border-top: solid #4a4a4a;
}
#input-row { height: 3; margin-top: 1; }
#question-input {
    width: 1fr; background: #242424; color: #f5f5f5; border: solid #4a4a4a;
}
#question-input:focus { border: solid #919191; }
Button {
    margin-left: 1; min-width: 10; background: #242424;
    color: #f5f5f5; border: solid #4a4a4a;
}
Button:hover { background: #4a4a4a; }
Button:focus { border: solid #f5f5f5; }
#settings-scroll { height: 1fr; padding: 1 2; }
.section-title {
    color: #f5f5f5; text-style: bold; border-bottom: solid #4a4a4a;
    padding: 1 0; margin-top: 1; margin-bottom: 1;
}
Label { height: auto; color: #919191; margin-top: 1; margin-bottom: 1; }
Input { background: #242424; color: #f5f5f5; border: solid #4a4a4a; }
Select {
    width: 1fr; background: #242424; color: #f5f5f5;
    border: solid #4a4a4a; margin-bottom: 1;
}
Checkbox { margin-top: 1; margin-bottom: 1; }
.path-row { height: 3; margin-bottom: 1; }
.path-row Input { width: 1fr; }
#vosk-note, #llm-note {
    color: #919191; height: auto; margin-bottom: 1;
}
#vosk-actions, #llm-actions {
    height: 3; margin-top: 1; margin-bottom: 1;
}
#settings-actions { height: 5; margin-top: 2; margin-bottom: 2; }
#settings-actions Button { width: auto; min-width: 18; }

#commands-note, #commands-safety-note {
    color: #919191; height: auto; margin-bottom: 1;
}
#voice-commands {
    height: 16; min-height: 10; border: solid #4a4a4a;
    background: #242424; color: #f5f5f5;
}
#voice-commands:focus { border: solid #919191; }
